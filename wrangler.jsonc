{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garansi-api-v2",
  "main": "worker.js",
  "compatibility_date": "2026-07-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juastore-garansi-db",
      "database_id": "GANTI_DENGAN_DATABASE_ID_D1"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://juastore.biz.id"
  }
}
